# Maintainer: Jerome Jardinero
# Local-source recipe. Generate PKGBUILD with scripts/package-arch.sh.
pkgname=relay
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native Wayland RDP client with GPU video decoding'
arch=('x86_64')
license=('MIT OR Apache-2.0' 'OFL-1.1')
depends=(
  'alsa-lib'
  'ffmpeg'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libglvnd'
  'libva'
  'libxkbcommon'
  'openh264'
  'openssl'
  'vulkan-icd-loader'
  'wayland'
  'zlib'
  'libavcodec.so'
  'libavutil.so'
  'libva.so'
  'libopenh264.so=8-64'
)
makedepends=('cargo' 'pkgconf')
checkdepends=('desktop-file-utils')
optdepends=(
  'vulkan-driver: Vulkan rendering and GPU frame import'
  'libva-driver: hardware H.264 video decoding'
  'org.freedesktop.secrets: saving connection passwords in a keyring'
  'fuse3: pasting files copied on the remote computer'
)
# Cargo.toml already enables thin LTO. Avoid a second native LTO setting and
# avoid generating a separate debug package on hosts that enable one globally.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  source scripts/package-common.sh
  _relay_source=$PWD
  relay_refresh_cargo_sources
  cargo build --release --frozen --bin relay
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  cargo test --release --frozen --bin relay
  source scripts/package-common.sh
  _relay_source=$PWD
  relay_record_cargo_sources
  desktop-file-validate packaging/common/relay.desktop
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  bash scripts/install-package.sh "$CARGO_TARGET_DIR/release/relay" "$pkgdir" /usr/share/licenses/relay
}
